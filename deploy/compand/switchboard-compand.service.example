[Unit]
Description=Switchboard Compand pilot gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=projectplanner
Group=projectplanner
WorkingDirectory=/opt/projectplanner
EnvironmentFile=/etc/projectplanner/compand.env
ExecStart=/opt/projectplanner/.venv/bin/uvicorn switchboard.services.compand.app:app --app-dir src --host 127.0.0.1 --port 8127
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/projectplanner/compand

[Install]
WantedBy=multi-user.target
