# /etc/systemd/system/projectplanner-mcp.service
[Unit]
Description=ProjectPlanner MCP server (:8111, localhost)
After=network-online.target projectplanner-gateway.service
Wants=network-online.target

[Service]
Slice=projectplanner-interactive.slice
Type=simple
# HARDEN-55: dedicated non-login service account (not the general `ubuntu` login).
User=projectplanner
Group=projectplanner
WorkingDirectory=/opt/projectplanner
EnvironmentFile=/opt/projectplanner/.env
# Production MCP reads and writes must fail closed even if .env is missing PM_AUTH_MODE.
Environment=PM_AUTH_MODE=required
# Every MCP-created deliverable must carry intake shape (end_state, acceptance_criteria,
# proof_requirements).
Environment=PM_ENFORCE_DELIVERABLE_INTAKE=1
# Code tree is read-only; don't try to write .pyc back into it.
Environment=PYTHONDONTWRITEBYTECODE=1
# CI-12/BUG-323: verify_ci(ensure=true) is an MCP tool, so this unit reaches the
# scratchpad mirror dispatcher exactly like the web unit does. Without this it falls
# back to PM_REPO_PATH / the deployed tree, which ProtectSystem=strict keeps read-only —
# `git fetch` then dies on FETCH_HEAD for every SHA. Point it at the same writable
# service-owned coordination clone.
Environment=SWITCHBOARD_CI_SOURCE_PATH=/var/lib/projectplanner/ci-source
ExecStart=/opt/projectplanner/.venv/bin/python /opt/projectplanner/mcp_server.py
Restart=always
RestartSec=3
# HARDEN-55: runtime least-privilege sandbox. Code tree + venv are root-owned and
# read-only to this service; the only writable path is the data dir (+ journal).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/projectplanner

[Install]
WantedBy=multi-user.target
