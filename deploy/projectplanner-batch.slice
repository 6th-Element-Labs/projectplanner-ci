# /etc/systemd/system/projectplanner-batch.slice
# PERF-4: timer/oneshot tier (reconcile, narrate, monitors, …). Low CPU/IO share
# with a hard quota so batch work is provably capped under load.
[Unit]
Description=ProjectPlanner batch tier (timers, reconcile, narrate, monitors)
Before=slices.target

[Slice]
CPUWeight=50
# ~40% of a 2-vCPU box (80% of one CPU unit).
CPUQuota=80%
IOWeight=10
MemoryHigh=512M
# BUG-245: MemoryHigh throttling plus unlimited swap let one over-budget batch
# job (reconcile parsing 229 MB of pre-BUG-243 snapshot bodies) wedge in the
# kernel reclaim loop for 11 hours instead of OOM-killing at its MemoryMax —
# and monopolize the box's entire 512M zram device. Bounding swap for the tier
# restores fail-fast for every batch unit at once.
MemorySwapMax=64M
