{
  "$id": "switchboard.agent.revoke_host_project_access_command.v1",
  "additionalProperties": false,
  "description": "Revoke one Host placement grant without revoking Host ownership.",
  "properties": {
    "grant_id": {
      "minLength": 1,
      "pattern": "^hostgrant-.+",
      "title": "Grant Id",
      "type": "string"
    },
    "project": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Project",
      "type": "string"
    },
    "reason": {
      "default": "operator_revoke",
      "title": "Reason",
      "type": "string"
    },
    "schema": {
      "default": "switchboard.agent.revoke_host_project_access_command.v1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "project",
    "grant_id"
  ],
  "title": "RevokeHostProjectAccessCommand",
  "type": "object"
}
