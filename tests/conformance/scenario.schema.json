{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "switchboard.completion_conformance.scenario.v1",
  "title": "Switchboard completion conformance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "expect", "world", "timing"],
  "properties": {
    "schema": {
      "const": "switchboard.completion_conformance.scenario.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal", "reason_code", "role_sequence", "route", "effect"],
      "properties": {
        "terminal": {
          "enum": ["merged", "blocked", "human", "reconcile_done"]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "role_sequence": {
          "type": "array",
          "items": {
            "enum": ["review_merge", "remediation"]
          }
        },
        "route": {
          "enum": [
            "none",
            "wait",
            "reconcile",
            "human",
            "remediation",
            "review_merge",
            "coordination_retry"
          ]
        },
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "missing_artifact_near_miss_keys": {
          "description": "COORD-78/CO-21. Evidence keys the classifier's missing_artifact report must name. Present only on scenarios whose refusal has a near miss; an empty list is written as absence, never as [].",
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft",
        "ci",
        "ci_context",
        "ci_attribution",
        "review",
        "mergeable",
        "merge_state_status",
        "queue",
        "runner"
      ],
      "properties": {
        "draft": {"type": "boolean"},
        "ci": {
          "enum": [
            "pass",
            "fail",
            "pending",
            "missing",
            "error",
            "timed_out",
            "action_required",
            "cancelled",
            "stale",
            "startup_failure"
          ]
        },
        "ci_context": {"type": "string", "minLength": 1},
        "ci_attribution": {
          "enum": ["product", "infrastructure", "unknown"]
        },
        "review": {
          "enum": ["passed", "missing", "changes_requested"]
        },
        "review_findings": {
          "enum": ["none", "automatic", "judgment"],
          "description": "Optional findings class when review=changes_requested. Default none (empty findings -> human judgment path)."
        },
        "review_retry_exhausted": {
          "type": "boolean",
          "description": "When true, review payload carries retry_exhausted for the human exhausted-budget route."
        },
        "mergeable": {
          "type": ["boolean", "null"]
        },
        "merge_state_status": {
          "enum": ["CLEAN", "BLOCKED", "DIRTY", "BEHIND", "UNKNOWN"]
        },
        "pr_state": {
          "enum": ["open", "merged", "closed"],
          "description": "GitHub PR lifecycle. Default open."
        },
        "reopen_authorized": {
          "type": "boolean",
          "description": "Only for pr_state=closed. When true, closed unmerged routes to coordination_retry."
        },
        "queue": {
          "enum": ["none", "queued", "unmergeable", "ejected", "locked"],
          "description": "none=never queued; queued=in merge queue; unmergeable=GitHub UNMERGEABLE entry; ejected=tip still green but removed from queue after a prior enqueue (failed_checks / checks_timed_out); locked=merge queue LOCKED"
        },
        "queue_removal_reason": {
          "enum": ["failed_checks", "checks_timed_out"],
          "description": "Only for queue=ejected. Which RemovedFromMergeQueueEvent reason GitHub recorded."
        },
        "queue_retry_exhausted": {
          "type": "boolean",
          "description": "Only for queue=locked. When true, locked dwell escalates to coordination_retry."
        },
        "also_pending_contexts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "Extra required contexts that are still pending while ci_context uses world.ci (BREAKDOWN 15 / tip UNSTABLE)."
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live", "role", "head"],
          "properties": {
            "live": {"type": "boolean"},
            "role": {
              "enum": ["none", "review_merge", "remediation"]
            },
            "head": {
              "enum": ["same", "stale", "none"]
            }
          }
        },
        "evidence": {
          "description": "COORD-78 board-evidence axis, fed through the real application.commands.merge_gate. Optional: a scenario that omits it asserts the evidence world derived from the PR world by tests/conformance/_evidence.default_evidence, not an unmodelled one.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executed_test_run",
            "external_ci",
            "work_session",
            "review_verdict"
          ],
          "properties": {
            "executed_test_run": {
              "enum": ["valid", "missing", "near_miss_key", "failed", "stale_head"]
            },
            "external_ci": {
              "enum": [
                "green_exact_head",
                "green_other_head",
                "failed",
                "pending",
                "none"
              ]
            },
            "work_session": {
              "enum": ["present", "missing", "borrowed"]
            },
            "review_verdict": {
              "enum": ["pass", "missing", "stale", "open_findings", "not_passed"]
            }
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ci_delay_seconds",
        "never_report",
        "hang_seconds",
        "close_pr_while_runner_live",
        "move_head_during_assessment"
      ],
      "properties": {
        "ci_delay_seconds": {"type": "number", "minimum": 0},
        "never_report": {"type": "boolean"},
        "hang_seconds": {"type": "number", "minimum": 0},
        "close_pr_while_runner_live": {"type": "boolean"},
        "move_head_during_assessment": {"type": "boolean"}
      }
    }
  }
}
